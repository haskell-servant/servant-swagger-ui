packages:
  servant-swagger-ui/
  servant-swagger-ui-core/
  servant-swagger-ui-example/
  servant-swagger-ui-jensoleg/
  servant-swagger-ui-redoc/

if(impl(ghc >= 9.14.1))
  constraints: aeson>=2.3
  constraints: base-compat>=0.15

  allow-newer: servant-server:base
  allow-newer: servant-swagger:base
  allow-newer: servant-swagger:base-compat
  allow-newer: servant:base

  -- https://github.com/erikd/insert-ordered-containers/issues/10
  allow-newer: insert-ordered-containers:aeson
